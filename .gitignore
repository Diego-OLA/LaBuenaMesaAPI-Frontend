# ==============================================================
#  .gitignore raíz (monorepo)
#  Cada subproyecto (api/ y web/) tiene además su propio
#  .gitignore con reglas específicas de su ecosistema.
# ==============================================================

# ---------- Variables de entorno ----------
.env
.env.*
!.env.example

# ---------- Dependencias y artefactos de build ----------
**/node_modules/
**/vendor/
**/.next/
**/public/build/
**/public/hot

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Editores / IDEs ----------
.idea/
.vscode/

# ---------- Logs ----------
*.log
