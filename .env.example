# ==============================================================
#  Variables de docker-compose (este archivo se copia a .env)
#  Uso:  cp .env.example .env
# ==============================================================

# --------------------------------------------------------------
#  MySQL (servicio "mysql")
# --------------------------------------------------------------
# Nombre de la base de datos que se crea en el primer arranque.
MYSQL_DATABASE=la_buena_mesa
# Usuario de aplicación (NO es root) y su contraseña.
MYSQL_USER=labuena
MYSQL_PASSWORD=labuena_secret
# Contraseña del usuario root de MySQL. Solo para administración.
MYSQL_ROOT_PASSWORD=root_secret

# --------------------------------------------------------------
#  Laravel (servicio "api")
# --------------------------------------------------------------
# Clave de cifrado de la aplicación.
# Genera una propia con:  php artisan key:generate --show
# (ejecutándolo dentro de api/). Si se deja vacía, el compose
# usa una clave de desarrollo incluida en docker-compose.yml.
APP_KEY=base64:3FsFkCdlIFGtcjY7jxRxlg2l1NZgdP6jAqzZtNPkKKE=
# URL pública con la que la API se identifica a sí misma.
APP_URL=http://localhost:8000

# --------------------------------------------------------------
#  Frontend Next.js (servicio "web")
# --------------------------------------------------------------
# OJO: son dos URLs distintas y es el error más común.
#
# 1) NEXT_PUBLIC_API_URL -> la usa el NAVEGADOR del usuario.
#    Debe apuntar al puerto que Docker publica en tu máquina.
#    Se inyecta en tiempo de build, por eso está en build.args.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
#
# 2) API_URL -> la usan los Server Components (SSR) DENTRO de la
#    red de Docker, donde el host "localhost" es el contenedor web
#    y no la API. Por eso se usa el nombre del servicio: nginx.
#    Ya viene fijada en docker-compose.yml (http://nginx/api) y
#    normalmente NO necesitas cambiarla aquí.

# --------------------------------------------------------------
#  Puertos publicados en el host (opcional)
# --------------------------------------------------------------
# Frontend: http://localhost:3000
# API:      http://localhost:8000/api
# MySQL:    localhost:3307 (para DBeaver / MySQL Workbench)
